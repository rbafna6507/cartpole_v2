#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
for argument in "$@"; do
    if [ "$argument" = "--help" ] || [ "$argument" = "-h" ]; then
        exec uv run --locked --project "$repo_dir" python "$repo_dir/examples/prepare_rig_training.py" "$@"
    fi
done
exec uv run --locked --project "$repo_dir" --extra sim python "$repo_dir/examples/prepare_rig_training.py" "$@"

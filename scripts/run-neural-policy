#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
for argument in "$@"; do
    if [ "$argument" = "--help" ] || [ "$argument" = "-h" ]; then
        exec uv run --project "$repo_dir" python "$repo_dir/examples/run_neural_policy.py" "$@"
    fi
done
exec uv run --project "$repo_dir" --extra hardware python "$repo_dir/examples/run_neural_policy.py" "$@"

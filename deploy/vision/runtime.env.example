# Set from measured rates on the connected camera, not its advertised maximum.
VISION_FPS=30
VISION_VIDEO_FPS=30
VISION_DETECTOR_WIDTH=640
# Defaults preserve 960x600 and 180-degree rotation. Recalibrate after geometry changes.

VISION_VIDEO_BITRATE=4000

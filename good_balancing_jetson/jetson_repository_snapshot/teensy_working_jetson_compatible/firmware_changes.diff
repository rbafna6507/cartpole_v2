+// USB stop/off remains available even while TCP owns control. Other USB
+// commands cannot refresh the TCP controller's existing host watchdog.
+void handleUsbLine(char *line) {
+  const char *p=line;while(*p==' ' || *p=='\t')++p;
+  const bool stop=(!strncmp(p,"stop",4) && (!p[4] || p[4]==' ' || p[4]=='\t'));
+  const bool off=(!strncmp(p,"off",3) && (!p[3] || p[3]==' ' || p[3]=='\t'));
+  if(pendulum_net::active){
+    if(!stop && !off){checkedPrintln("! TCP owns control; USB stop/off only");return;}
+    eStop();pendulum_net::close();
+  }
+  handleLine(line);
+}
+void ethernetLost(){eStop();host_seen=false;}
